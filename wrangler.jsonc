{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ccj-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-11",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ccj-api",
      "database_id": "9240e550-ccbc-4c99-a9e4-80d30c85b828"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "ccj-storage"
    }
  ]
}
