{
  "name": "ccj-backend",
  "version": "1.0.0",
  "description": "CCJ Backend API with TypeScript, Node.js, and MySQL",
  "main": "dist/server.js",
  "scripts": {
    "prebuild": "npm install",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate:run": "ts-node scripts/run-migrations-node.ts",
    "db:create": "ts-node scripts/create-database.ts",
    "db:recreate": "ts-node scripts/recreate-tables.ts",
    "fix-admin": "ts-node scripts/fix-admin-password.ts",
    "fix-blogs": "ts-node scripts/fix-blogs-table.ts",
    "seed": "ts-node src/database/seed.ts",
    "db:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-database-full.ps1 -Method docker",
    "db:setup:local": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-database-full.ps1 -Method local",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose down",
    "db:logs": "docker-compose logs -f mysql",
    "db:prod:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-production-db.ps1"
  },
  "keywords": [
    "api",
    "backend",
    "typescript",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.4",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5",
    "nodemailer": "^7.0.12",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
