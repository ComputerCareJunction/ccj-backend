{
  "name": "ccj-backend",
  "version": "1.0.0",
  "description": "Computer Care Junction Backend API (Cloudflare Workers, D1 Database & R2 Storage)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate": "wrangler d1 execute ccj-api --remote --file=schema.sql",
    "d1:migrate:dashboard": "wrangler d1 execute ccj-api --remote --file=migrations/0002_dashboard_api.sql",
    "d1:migrate:firebase-employees": "wrangler d1 execute ccj-api --remote --file=migrations/0003_firebase_employee_link.sql",
    "d1:migrate:careers": "wrangler d1 execute ccj-api --remote --file=migrations/0004_careers.sql",
    "d1:migrate:application-users": "wrangler d1 execute ccj-api --remote --file=migrations/0005_application_user_access.sql",
    "d1:migrate:section-permissions": "wrangler d1 execute ccj-api --remote --file=migrations/0006_section_permissions.sql",
    "d1:migrate:tickets": "wrangler d1 execute ccj-api --remote --file=migrations/0007_ticket_serials_and_timestamps.sql",
    "d1:migrate:assets": "wrangler d1 execute ccj-api --remote --file=migrations/0008_assets.sql"
  },
  "keywords": [
    "api",
    "backend",
    "cloudflare-workers",
    "cloudflare-d1",
    "typescript"
  ],
  "author": "Computer Care Junction LLP",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.3.3",
    "wrangler": "^4.81.1"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0"
  }
}
